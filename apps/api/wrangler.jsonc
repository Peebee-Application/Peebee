{
  "account_id": "5b3ae942adb5457f1fa4d7f5effbf3ff",
  "name": "peebee-api",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-12",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "routes": [{ "pattern": "api.peebee.online", "custom_domain": true }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "peebee-api",
      "database_id": "4c80fcd2-0c4e-4594-a598-2b93ae36040d",
      "migrations_dir": "src/db/migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "RIDER_DOCS",
      "bucket_name": "peebee"
    }
  ],
  "ai": {
    "binding": "AI"
  },
  // Daily at 03:00 UTC — sweeps recurring rider subscribers whose
  // paid-through date has passed and attempts to renew them. See
  // src/worker.ts's scheduled() and src/riders/subscription.ts.
  "triggers": {
    "crons": ["*/2 * * * *", "0 3 * * *"]
  },
  "vars": {
    "ENVIRONMENT": "production",
    "GOOGLE_CLIENT_ID": "800078968934-7va1llsnhh3rdegsk6k65sq59iligtsg.apps.googleusercontent.com",
    "CORS_ORIGINS": "https://peebee.online,https://www.peebee.online,https://customer.peebee.online,https://rider.peebee.online,https://admin.peebee.online,https://food.peebee.online,https://restaurant.peebee.online,https://merchant.peebee.online,https://car.peebee.online,https://partner.peebee.online,https://sales.peebee.online,https://peebee-customer.peebeeapp.workers.dev,https://peebee-rider.peebeeapp.workers.dev,https://peebee-admin.peebeeapp.workers.dev,https://peebee-restaurant.peebeeapp.workers.dev,https://peebee-merchant.peebeeapp.workers.dev,https://peebee-partner.peebeeapp.workers.dev,https://peebee-sales.peebeeapp.workers.dev,https://peebee.peebeeapp.workers.dev",
    "PUBLIC_API_URL": "https://api.peebee.online",
    "CUSTOMER_APP_URL": "https://customer.peebee.online",
    "RIDER_APP_URL": "https://rider.peebee.online",
    "RESTAURANT_APP_URL": "https://food.peebee.online",
    "ADMIN_APP_URL": "https://admin.peebee.online",
    "CUSTOMER_APP_URL_LOGO": "https://customer.peebee.online/brand/peebee-logo-light.svg?v=logo-6",
    "PAYMENTS_PROVIDER": "yo_mock",
    "VAPID_PUBLIC_KEY": "BGbpg3q8fU6-wKotX4qxWcue9mn5dzourGStQEBs4RF6F1du6j8OJAsAUf49dq6CU1xNyumwzHu9CaDnSCw800Y"
  }
}
