    "build:merchant": "pnpm --filter merchant build",
    "build:web": "pnpm --filter web build",
    "build:api": "pnpm --filter api build",
    "migrate:api": "pnpm --filter api migrate",
    "seed:api": "pnpm --filter api seed",
